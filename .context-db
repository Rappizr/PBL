-- Drop table

-- DROP TABLE public.buku_kas;

CREATE TABLE public.buku_kas (
	id serial4 NOT NULL,
	keterangan text NULL,
	tipe_transaksi varchar(20) NOT NULL,
	nominal numeric(12, 2) NOT NULL,
	tanggal_transaksi timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	pemilik_id int4 NULL,
	penghuni_id int4 NULL,
	pembayaran_id int4 NULL,
	CONSTRAINT buku_kas_pembayaran_id_key UNIQUE (pembayaran_id),
	CONSTRAINT buku_kas_pkey PRIMARY KEY (id),
	CONSTRAINT buku_kas_tipe_transaksi_check CHECK (((tipe_transaksi)::text = ANY ((ARRAY['pemasukan'::character varying, 'pengeluaran'::character varying])::text[]))),
	CONSTRAINT buku_kas_pembayaran_id_fkey FOREIGN KEY (pembayaran_id) REFERENCES public.pembayaran(id) ON DELETE SET NULL,
	CONSTRAINT buku_kas_pemilik_id_fkey FOREIGN KEY (pemilik_id) REFERENCES public.pemilik(id) ON DELETE SET NULL,
	CONSTRAINT buku_kas_penghuni_id_fkey FOREIGN KEY (penghuni_id) REFERENCES public.penghuni(id) ON DELETE SET NULL
);
CREATE INDEX idx_buku_kas_tanggal ON public.buku_kas USING btree (tanggal_transaksi);

-- Drop table

-- DROP TABLE public.kamar;

CREATE TABLE public.kamar (
	id serial4 NOT NULL,
	no_kamar varchar(20) NOT NULL,
	status_kamar varchar(20) DEFAULT 'kosong'::character varying NOT NULL,
	CONSTRAINT kamar_no_kamar_key UNIQUE (no_kamar),
	CONSTRAINT kamar_pkey PRIMARY KEY (id),
	CONSTRAINT kamar_status_kamar_check CHECK (((status_kamar)::text = ANY ((ARRAY['kosong'::character varying, 'terisi'::character varying, 'maintenance'::character varying])::text[])))
);

-- Drop table

-- DROP TABLE public.kategori_iuran;

CREATE TABLE public.kategori_iuran (
	id serial4 NOT NULL,
	nama_iuran varchar(100) NOT NULL,
	nominal numeric(12, 2) NOT NULL,
	tanggal_mulai date NULL,
	tanggal_selesai date NULL,
	CONSTRAINT kategori_iuran_pkey PRIMARY KEY (id)
);

-- Drop table

-- DROP TABLE public.pembayaran;

CREATE TABLE public.pembayaran (
	id serial4 NOT NULL,
	tagihan_id int4 NOT NULL,
	bukti_pembayaran text NULL,
	jumlah_bayar numeric(12, 2) NOT NULL,
	metode_bayar varchar(30) DEFAULT 'transfer'::character varying NULL,
	tanggal_bayar timestamp DEFAULT CURRENT_TIMESTAMP NULL,
	status_verifikasi varchar(20) DEFAULT 'pending'::character varying NULL,
	no_kwitansi varchar(50) NULL,
	alasan_penolakan varchar(255) NULL,
	CONSTRAINT pembayaran_metode_bayar_check CHECK (((metode_bayar)::text = ANY ((ARRAY['transfer'::character varying, 'tunai'::character varying, 'qris'::character varying, 'lainnya'::character varying])::text[]))),
	CONSTRAINT pembayaran_no_kwitansi_key UNIQUE (no_kwitansi),
	CONSTRAINT pembayaran_pkey PRIMARY KEY (id),
	CONSTRAINT pembayaran_status_verifikasi_check CHECK (((status_verifikasi)::text = ANY ((ARRAY['pending'::character varying, 'diterima'::character varying, 'ditolak'::character varying])::text[]))),
	CONSTRAINT pembayaran_tagihan_id_fkey FOREIGN KEY (tagihan_id) REFERENCES public.tagihan(id) ON DELETE CASCADE
);
CREATE INDEX idx_pembayaran_tagihan ON public.pembayaran USING btree (tagihan_id);

-- Drop table

-- DROP TABLE public.pemilik;

CREATE TABLE public.pemilik (
	id serial4 NOT NULL,
	pin varchar(10) NOT NULL,
	nama varchar(100) NOT NULL,
	no_wa varchar(20) NULL,
	no_rekening varchar(50) NULL,
	email varchar(100) NULL,
	CONSTRAINT pemilik_email_key UNIQUE (email),
	CONSTRAINT pemilik_pkey PRIMARY KEY (id)
);

-- Drop table

-- DROP TABLE public.penghuni;

CREATE TABLE public.penghuni (
	id serial4 NOT NULL,
	foto_ktp text NULL,
	is_ketua_kos bool DEFAULT false NULL,
	nama varchar(100) NOT NULL,
	pin varchar(10) NOT NULL,
	status_akun varchar(20) DEFAULT 'aktif'::character varying NULL,
	kontak_wali varchar(20) NULL,
	no_wa varchar(20) NULL,
	email varchar(255) NULL,
	CONSTRAINT penghuni_pkey PRIMARY KEY (id),
	CONSTRAINT penghuni_status_akun_check CHECK (((status_akun)::text = ANY ((ARRAY['aktif'::character varying, 'nonaktif'::character varying, 'pending'::character varying])::text[])))
);

-- Drop table

-- DROP TABLE public.penghuni_kamar;

CREATE TABLE public.penghuni_kamar (
	id serial4 NOT NULL,
	kamar_id int4 NOT NULL,
	penghuni_id int4 NOT NULL,
	tanggal_masuk date NOT NULL,
	tanggal_selesai date NULL,
	skema_id int4 NOT NULL,
	CONSTRAINT penghuni_kamar_pkey PRIMARY KEY (id),
	CONSTRAINT penghuni_kamar_kamar_id_fkey FOREIGN KEY (kamar_id) REFERENCES public.kamar(id) ON DELETE CASCADE,
	CONSTRAINT penghuni_kamar_penghuni_id_fkey FOREIGN KEY (penghuni_id) REFERENCES public.penghuni(id) ON DELETE CASCADE,
	CONSTRAINT penghuni_kamar_skema_id_fkey FOREIGN KEY (skema_id) REFERENCES public.skema_sewa(id) ON DELETE RESTRICT
);
CREATE INDEX idx_penghuni_kamar_kamar ON public.penghuni_kamar USING btree (kamar_id);
CREATE INDEX idx_penghuni_kamar_penghuni ON public.penghuni_kamar USING btree (penghuni_id);
CREATE INDEX idx_penghuni_kamar_skema ON public.penghuni_kamar USING btree (skema_id);

-- Drop table

-- DROP TABLE public.peraturan_kos;

CREATE TABLE public.peraturan_kos (
	id int4 GENERATED ALWAYS AS IDENTITY( INCREMENT BY 1 MINVALUE 1 MAXVALUE 2147483647 START 1 CACHE 1 NO CYCLE) NOT NULL,
	create_time date NULL,
	peraturan varchar(255) NULL,
	deskripsi varchar(255) NULL,
	icon varchar(100) DEFAULT 'fa-solid fa-circle-info'::character varying NULL,
	CONSTRAINT peraturan_kos_pkey PRIMARY KEY (id)
);

-- Drop table

-- DROP TABLE public.skema_sewa;

CREATE TABLE public.skema_sewa (
	id serial4 NOT NULL,
	nama_skema varchar(50) NOT NULL,
	tipe_periode varchar(20) DEFAULT 'bulan'::character varying NOT NULL,
	durasi_nilai int4 DEFAULT 1 NOT NULL,
	nominal numeric(12, 2) DEFAULT 0 NULL,
	harga_default numeric(12, 2) DEFAULT 0 NULL,
	CONSTRAINT skema_sewa_nama_skema_key UNIQUE (nama_skema),
	CONSTRAINT skema_sewa_pkey PRIMARY KEY (id)
);

-- Drop table

-- DROP TABLE public.tagihan;

CREATE TABLE public.tagihan (
	id serial4 NOT NULL,
	penghuni_kamar_id int4 NOT NULL,
	kategori_iuran_id int4 NULL,
	tanggal_jatuh_tempo date NOT NULL,
	status_tagihan varchar(20) DEFAULT 'belum_bayar'::character varying NULL,
	tanggal_awal_tagihan date NOT NULL,
	CONSTRAINT tagihan_pkey PRIMARY KEY (id),
	CONSTRAINT tagihan_status_tagihan_check CHECK (((status_tagihan)::text = ANY ((ARRAY['belum_bayar'::character varying, 'sebagian'::character varying, 'lunas'::character varying, 'terlambat'::character varying])::text[]))),
	CONSTRAINT tagihan_kategori_iuran_id_fkey FOREIGN KEY (kategori_iuran_id) REFERENCES public.kategori_iuran(id) ON DELETE SET NULL,
	CONSTRAINT tagihan_penghuni_kamar_id_fkey FOREIGN KEY (penghuni_kamar_id) REFERENCES public.penghuni_kamar(id) ON DELETE CASCADE
);
CREATE INDEX idx_tagihan_penghuni_kamar ON public.tagihan USING btree (penghuni_kamar_id);

-- DROP SCHEMA public;

CREATE SCHEMA public AUTHORIZATION pg_database_owner;

-- DROP SCHEMA public;

CREATE SCHEMA public AUTHORIZATION pg_database_owner;

CREATE OR REPLACE VIEW public.v_status_kamar_penghuni
AS SELECT k.id AS kamar_id,
    k.no_kamar,
    k.status_kamar,
    COALESCE(p.nama, ''::character varying) AS nama_penghuni,
    COALESCE(p.no_wa, ''::character varying) AS no_wa,
    COALESCE(s.nominal, 0::numeric) AS harga_sewa,
    pk.tanggal_masuk,
    COALESCE(t_latest.status_tagihan, 'lunas'::character varying) AS status_pembayaran_terakhir
   FROM kamar k
     LEFT JOIN penghuni_kamar pk ON k.id = pk.kamar_id
     LEFT JOIN penghuni p ON pk.penghuni_id = p.id
     LEFT JOIN skema_sewa s ON pk.skema_id = s.id
     LEFT JOIN LATERAL ( SELECT tagihan.status_tagihan
           FROM tagihan
          WHERE tagihan.penghuni_kamar_id = pk.id
          ORDER BY tagihan.tanggal_jatuh_tempo DESC
         LIMIT 1) t_latest ON true
  ORDER BY k.no_kamar;

-- DROP SCHEMA public;

CREATE SCHEMA public AUTHORIZATION pg_database_owner;

CREATE MATERIALIZED VIEW public.mv_ringkasan_kas_bulanan
TABLESPACE pg_default
AS SELECT to_char(tanggal_transaksi, 'YYYY-MM'::text) AS periode_bulan,
    sum(
        CASE
            WHEN tipe_transaksi::text = 'pemasukan'::text THEN nominal
            ELSE 0::numeric
        END) AS total_pemasukan,
    sum(
        CASE
            WHEN tipe_transaksi::text = 'pengeluaran'::text THEN nominal
            ELSE 0::numeric
        END) AS total_pengeluaran,
    sum(
        CASE
            WHEN tipe_transaksi::text = 'pemasukan'::text THEN nominal
            ELSE 0::numeric
        END) - sum(
        CASE
            WHEN tipe_transaksi::text = 'pengeluaran'::text THEN nominal
            ELSE 0::numeric
        END) AS saldo_bersih
   FROM buku_kas
  GROUP BY (to_char(tanggal_transaksi, 'YYYY-MM'::text))
  ORDER BY (to_char(tanggal_transaksi, 'YYYY-MM'::text)) DESC
WITH DATA;

-- View indexes:
CREATE UNIQUE INDEX idx_mv_kas_periode ON public.mv_ringkasan_kas_bulanan USING btree (periode_bulan);

