/**
 * SITEMAN - KOS Global UI & Form Helper
 * Menangani: Modal universal, Toast notifikasi, Loading submit seragam,
 * Sanitasi input (angka/huruf/HP/PIN), Format Rupiah, & Lightbox gambar.
 */
(function () {
  "use strict";

  // =========================================================================
  // 1. ANIMASI LOADING TOMBOL (SERAGAM SEPERTI PERATURAN KOS)
  // =========================================================================
  window.setSitemanBtnLoading = function (
    btnUtama,
    btnBatal = null,
    teksLoading = "Memproses...",
  ) {
    if (btnUtama) {
      btnUtama.disabled = true;
      btnUtama.style.opacity = "0.65";
      btnUtama.style.cursor = "not-allowed";
      btnUtama.style.pointerEvents = "none";
      btnUtama.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i> <span>${teksLoading}</span>`;
    }
    if (btnBatal) {
      btnBatal.disabled = true;
      btnBatal.style.opacity = "0.5";
      btnBatal.style.cursor = "not-allowed";
      btnBatal.style.pointerEvents = "none";
    }
  };

  document.addEventListener("submit", function (e) {
    const form = e.target;
    if (!form || (form.method || "").toUpperCase() !== "POST") return;
    if (e.defaultPrevented) return;
    if (typeof form.checkValidity === "function" && !form.checkValidity())
      return;

    // Cegah double-submit
    if (form.dataset.submitting === "1") {
      e.preventDefault();
      return;
    }
    form.dataset.submitting = "1";

    const submitBtn =
      e.submitter || form.querySelector('button[type="submit"]');
    const modalCard = form.closest(
      ".modal-card, .modal-card-detail-kamar, .modal-card-penghuni-custom, " +
        ".modal-card-konfirmasi-kamar, .modal-konfirmasi-verif-card, " +
        ".modal-bayar-card, .modal-tatib-card",
    );
    const cancelBtn = modalCard
      ? modalCard.querySelector(
          ".btn-modal-cancel, .btn-batal-custom, .btn-konfirmasi-batal, " +
            ".btn-konfir-batal, .btn-bayar-batal, .btn-detail-batal",
        )
      : null;

    if (submitBtn) {
      const labelAsli = submitBtn.textContent.trim().toLowerCase();
      let teksLoading = "Memproses...";

      if (labelAsli.includes("hapus")) teksLoading = "Menghapus...";
      else if (labelAsli.includes("simpan") || labelAsli.includes("update"))
        teksLoading = "Menyimpan...";
      else if (labelAsli.includes("pindah")) teksLoading = "Memindahkan...";
      else if (labelAsli.includes("kirim")) teksLoading = "Mengirim...";
      else if (labelAsli.includes("terima") || labelAsli.includes("setuju"))
        teksLoading = "Memverifikasi...";
      else if (labelAsli.includes("tolak")) teksLoading = "Menolak...";
      else if (labelAsli.includes("keluar")) teksLoading = "Keluar...";

      window.setSitemanBtnLoading(submitBtn, cancelBtn, teksLoading);
    }
  });

  // Reset flag submit jika browser kembali lewat cache (Back button)
  window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      document
        .querySelectorAll('form[data-submitting="1"]')
        .forEach(function (f) {
          delete f.dataset.submitting;
        });
    }
  });

  // =========================================================================
  // 2. KONTROL MODAL UNIVERSAL & TOMBOL ESCAPE
  // =========================================================================
  window.bukaModalInstan = function (e, modalId, modalParam = "") {
    if (e) e.preventDefault();
    const modal = document.getElementById(modalId);
    if (!modal) return;

    modal.classList.add("active");
    const firstInput = modal.querySelector(
      'input:not([type="hidden"]):not([readonly])',
    );
    if (firstInput) setTimeout(() => firstInput.focus(), 50);

    if (modalParam && window.history && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.set("modal", modalParam);
      window.history.replaceState({}, "", url);
    }
  };

  window.tutupSemuaModalInstan = function (e) {
    if (e) e.preventDefault();
    // Jangan tutup jika sedang dalam proses submit
    if (document.querySelector('form[data-submitting="1"]')) return;

    document.querySelectorAll(".modal-overlay.active").forEach(function (m) {
      m.classList.remove("active");
    });

    if (window.history && window.history.replaceState) {
      const url = new URL(window.location.href);
      url.searchParams.delete("modal");
      url.searchParams.delete("nomor");
      window.history.replaceState({}, "", url);
    }
  };

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      window.tutupSemuaModalInstan();
    }
  });

  // =========================================================================
  // 3. FLOATING TOAST NOTIFIKASI (AUTO-CLOSE & TOMBOL TUTUP)
  // =========================================================================
  window.closeSitemanToast = function (toastEl) {
    const target = toastEl || document.querySelector(".toast-alert");
    if (!target) return;
    target.style.opacity = "0";
    target.style.transform = "translateY(-15px) scale(0.95)";
    setTimeout(() => target.remove(), 300);
  };

  // =========================================================================
  // 4. FORMAT RUPIAH & SANITASI INPUT BERBASIS ATRIBUT (data-filter)
  // =========================================================================
  window.formatAngkaTitik = function (angka) {
    const clean = String(angka ?? "").replace(/\D/g, "");
    return clean ? new Intl.NumberFormat("id-ID").format(Number(clean)) : "";
  };

  window.formatRupiahInput = function (input) {
    input.value = window.formatAngkaTitik(input.value);
  };

  function terapkanFilterInput(el) {
    const filter = el.getAttribute("data-filter");
    if (!filter) return;

    if (filter === "numeric") {
      el.value = el.value.replace(/[^0-9]/g, "");
    } else if (filter === "phone") {
      el.value = el.value.replace(/[^0-9]/g, "");
      if (el.value.length >= 1 && !el.value.startsWith("0")) {
        el.value = "0" + el.value.replace(/^0+/, "");
      }
    } else if (filter === "alpha") {
      el.value = el.value.replace(/[^a-zA-Z\s'.]/g, "");
    } else if (filter === "rupiah") {
      el.value = window.formatAngkaTitik(el.value);
    }
  }

  document.addEventListener("input", function (e) {
    if (e.target && e.target.matches("[data-filter]")) {
      terapkanFilterInput(e.target);
    }
  });

  document.addEventListener("paste", function (e) {
    if (e.target && e.target.matches("[data-filter]")) {
      setTimeout(() => terapkanFilterInput(e.target), 10);
    }
  });

  // =========================================================================
  // 5. TOGGLE VISIBILITAS PIN / PASSWORD & LIGHTBOX GAMBAR
  // =========================================================================
  window.togglePasswordVisibility = function (fieldId, btn) {
    const input = document.getElementById(fieldId);
    if (!input) return;
    const icon = btn ? btn.querySelector("i") : null;
    if (input.type === "password") {
      input.type = "text";
      if (icon) {
        icon.classList.remove("fa-eye-slash");
        icon.classList.add("fa-eye");
      }
    } else {
      input.type = "password";
      if (icon) {
        icon.classList.remove("fa-eye");
        icon.classList.add("fa-eye-slash");
      }
    }
  };

  window.bukaPopupKtpDirect = function () {
    const modal = document.getElementById("modalLightboxKtp");
    if (modal) modal.classList.add("active");
  };

  window.tutupPopupKtp = function () {
    const modal = document.getElementById("modalLightboxKtp");
    if (modal) modal.classList.remove("active");
  };

  // =========================================================================
  // 6. INISIALISASI SAAT HALAMAN SIAP
  // =========================================================================
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".toast-alert").forEach(function (toast) {
      setTimeout(() => window.closeSitemanToast(toast), 4500);
    });
  });
})();

