Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Blokir akses langsung ke file sensitif
    RewriteRule ^(\.env|\.git|\.context-db|composer\.(json|lock)|vercel\.json|router\.php) - [F,L]
    RewriteRule ^(config|misc)/ - [F,L]

    # 2. Arahkan request /css/*, /js/*, /images/*, /uploads/* ke dalam folder public/
    RewriteRule ^(css|js|images|uploads)/(.*)$ public/$1/$2 [L]

    # 3. Jika file fisik benar-benar ada (misal index.php atau /api/...), jalankan langsung
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 4. Arahkan semua rute lainnya ke index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>